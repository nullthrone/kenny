# kenny-server example environment. Copy to .env (or export) and adjust.
# Nothing here is required for local dev; sensible defaults apply.
#
# Many of these can now also be changed at runtime from the dashboard's
# Settings tab (ADR-0034), which resolves DB override > this environment >
# coded default. Values set here act as the bootstrap floor; a UI change layers
# on top and takes effect without a restart. Secrets and wire-contract knobs
# stay environment-only and are shown read-only in the UI.

# --- Network / storage ------------------------------------------------------
# KENNY_HOST=127.0.0.1
# KENNY_PORT=8000
# KENNY_PUBLIC_URL=https://kenny.example.com
# KENNY_DB_PATH=kenny.sqlite

# --- Operator auth (MCP + /api + web UI) ------------------------------------
# Multi-user accounts (ADR-0037): the first account is created via the web UI
# on first run and becomes the superuser. Claude Desktop connects to /mcp via the
# built-in OAuth 2.1 flow (sign in + consent); per-user personal access tokens
# (Bearer) remain available for scripts and other MCP clients. The shared token(s)
# below remain accepted as a back-compat superuser credential so existing installs
# upgrade seamlessly.
# KENNY_OPERATOR_TOKEN=change-me
# KENNY_OPERATOR_TOKENS=tokenA,tokenB
# Browser login session lifetime in seconds (default 7 days).
# KENNY_SESSION_TTL_SECS=604800
# OAuth token lifetimes for connected MCP clients (access default 1h, refresh 30d).
# The refresh token rotates; reusing a rotated one revokes the whole grant. The
# OAuth issuer/metadata URLs derive from KENNY_PUBLIC_URL, so set that to your
# public https origin for a remote deployment.
# KENNY_OAUTH_ACCESS_TTL_SECS=3600
# KENNY_OAUTH_REFRESH_TTL_SECS=2592000
# When behind a reverse proxy (see the TLS profile), list the proxy's address(es)
# so the login rate-limiter sees the real client IP via X-Forwarded-For.
# KENNY_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Agent mutual authentication (ADR-0023) ---------------------------------
# Server-wide Ed25519 identity used to sign the challenge. The agent pins its
# PUBLIC half at install time. Provide the PRIVATE key as a base64 raw 32-byte
# seed, either inline or via a file. If neither is set, the server generates a
# keypair on first start, persists it in the DB, and logs the public key at
# WARNING so you can pin it in the installer.
# KENNY_SERVER_PRIVATE_KEY=<base64 raw 32-byte Ed25519 seed>
# KENNY_SERVER_PRIVATE_KEY_FILE=/etc/kenny/server_seed.b64

# Seconds a rotated-away agent public key keeps verifying after an operator
# re-key (0 = instant invalidation). Default 7 days.
# KENNY_KEY_GRACE_SECS=604800

# --- Push alerting (ADR-0029) ------------------------------------------------
# Operator notifications on health transitions and offline agents. With no
# channel configured, evaluation still runs and records alert history only.
# ntfy topic URL (https://ntfy.sh/<topic> or self-hosted) + optional token.
# KENNY_NTFY_URL=https://ntfy.sh/my-kenny-topic
# KENNY_NTFY_TOKEN=tk_...
# Generic JSON webhook (Discord/Home Assistant/...; payload: kind,title,body,...).
# KENNY_WEBHOOK_URL=https://example.com/kenny-hook
# Evaluation cadence in seconds (0 disables the loop entirely).
# KENNY_ALERT_INTERVAL_SECS=60
# Per-scope cooldown bounding flapping alerts, and the offline threshold
# (default: three missed 900 s telemetry pushes).
# KENNY_ALERT_COOLDOWN_SECS=3600
# KENNY_ALERT_OFFLINE_AFTER_SECS=2700
# Weekly fleet digest on the same channels (preview: GET /api/digest/preview).
# KENNY_DIGEST_ENABLED=1
# KENNY_DIGEST_DAY=mon
# KENNY_DIGEST_HOUR=8

# --- Legacy bearer-token auth (migration window) ----------------------------
# Accept the legacy per-agent register.token when an agent does not present
# signature material. Set to 0/false/"" to require signatures only (cutover).
# KENNY_ALLOW_TOKEN_AUTH=1

# Seconds a rotated-away agent token keeps verifying. Default 7 days.
# KENNY_TOKEN_GRACE_SECS=604800
# Seed per-agent tokens as id=token pairs (comma-separated).
# KENNY_AGENT_TOKENS=example-pc=secret1,lab-pc=secret2

# --- Discord bot surface & tickets -------------------------------------------
# Optional. Tickets work fully without any of this: the ticket store, lifecycle
# and sweeper always run, and the dashboard serves /api/tickets either way. The
# keys below only decide whether a Discord bot is also connected. Install the
# optional dependency first: pip install -e ".[discord]"
# Bot token of the Discord application (Bot > Reset Token in the Developer
# Portal). Enable the privileged "Message Content" and "Server Members" intents
# there too, otherwise kenny cannot read requests or list members.
# KENNY_DISCORD_BOT_TOKEN=
# Connect the bot at startup (needs the token and at least one guild).
# KENNY_DISCORD_ENABLED=0
# Comma-separated guild (server) snowflakes kenny reacts in. EMPTY MEANS DENY
# EVERYWHERE — there is no allow-all mode.
# KENNY_DISCORD_GUILD_IDS=
# Channel where a mention opens a ticket (empty: any channel of an allowed
# guild), and where operator approval cards are posted (empty: the ticket
# thread).
# KENNY_DISCORD_SUPPORT_CHANNEL_ID=
# KENNY_DISCORD_OPERATOR_CHANNEL_ID=
# Open each ticket in a private thread with only the requester invited.
# KENNY_DISCORD_PRIVATE_THREADS=1
# Model for the Discord surface; empty falls back to KENNY_CHAT_MODEL.
# KENNY_DISCORD_MODEL=
# Autonomy caps: turns per ticket, and requests per account per hour (0 = off).
# KENNY_DISCORD_MAX_TURNS_PER_TICKET=40
# KENNY_DISCORD_RATE_LIMIT_PER_USER_HOUR=20
# Ticket housekeeping (all also editable from the dashboard's Settings tab):
# how long a held tool call waits for a decision (an expiry counts as a denial),
# the reopen window before a resolved ticket is closed, the sweep cadence
# (0 disables the loop entirely) and its first-run delay.
# KENNY_TICKET_APPROVAL_TTL_SECS=86400
# KENNY_TICKET_AUTOCLOSE_SECS=172800
# KENNY_TICKET_SWEEP_INTERVAL_SECS=300
# KENNY_TICKET_SWEEP_INITIAL_DELAY=30
# How long a closed ticket keeps its working transcript (the ticket itself and
# its audit trail are never pruned).
# KENNY_TICKET_RETENTION_DAYS=365
# Alert push channel via a Discord incoming webhook (independent of the bot).
# KENNY_DISCORD_WEBHOOK_URL=
