# kenny-server example environment. Copy to .env (or export) and adjust.
# Nothing here is required for local dev; sensible defaults apply.

# --- Network / storage ------------------------------------------------------
# KENNY_HOST=127.0.0.1
# KENNY_PORT=8000
# KENNY_PUBLIC_URL=https://kenny.example.com
# KENNY_DB_PATH=kenny.sqlite

# --- Operator auth (MCP + /api + web UI) ------------------------------------
# KENNY_OPERATOR_TOKEN=change-me
# KENNY_OPERATOR_TOKENS=tokenA,tokenB

# --- Agent mutual authentication (ADR-0023) ---------------------------------
# Server-wide Ed25519 identity used to sign the challenge. The agent pins its
# PUBLIC half at install time. Provide the PRIVATE key as a base64 raw 32-byte
# seed, either inline or via a file. If neither is set, the server generates a
# keypair on first start, persists it in the DB, and logs the public key at
# WARNING so you can pin it in the installer.
# KENNY_SERVER_PRIVATE_KEY=<base64 raw 32-byte Ed25519 seed>
# KENNY_SERVER_PRIVATE_KEY_FILE=/etc/kenny/server_seed.b64

# Seconds a rotated-away agent public key keeps verifying after an operator
# re-key (0 = instant invalidation). Default 7 days.
# KENNY_KEY_GRACE_SECS=604800

# --- Push alerting (ADR-0028) ------------------------------------------------
# Operator notifications on health transitions and offline agents. With no
# channel configured, evaluation still runs and records alert history only.
# ntfy topic URL (https://ntfy.sh/<topic> or self-hosted) + optional token.
# KENNY_NTFY_URL=https://ntfy.sh/my-kenny-topic
# KENNY_NTFY_TOKEN=tk_...
# Generic JSON webhook (Discord/Home Assistant/...; payload: kind,title,body,...).
# KENNY_WEBHOOK_URL=https://example.com/kenny-hook
# Evaluation cadence in seconds (0 disables the loop entirely).
# KENNY_ALERT_INTERVAL_SECS=60
# Per-scope cooldown bounding flapping alerts, and the offline threshold
# (default: three missed 900 s telemetry pushes).
# KENNY_ALERT_COOLDOWN_SECS=3600
# KENNY_ALERT_OFFLINE_AFTER_SECS=2700

# --- Legacy bearer-token auth (migration window) ----------------------------
# Accept the legacy per-agent register.token when an agent does not present
# signature material. Set to 0/false/"" to require signatures only (cutover).
# KENNY_ALLOW_TOKEN_AUTH=1

# Seconds a rotated-away agent token keeps verifying. Default 7 days.
# KENNY_TOKEN_GRACE_SECS=604800
# Seed per-agent tokens as id=token pairs (comma-separated).
# KENNY_AGENT_TOKENS=example-pc=secret1,lab-pc=secret2
