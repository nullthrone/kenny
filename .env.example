# kenny-server environment — copy to .env and fill in.
#   cp .env.example .env && docker compose up -d
# See docs/setup.md for the full reference.

# REQUIRED: operator bearer token for the MCP endpoint, dashboard, and chat.
# Generate one, e.g.: openssl rand -hex 32
KENNY_OPERATOR_TOKEN=

# OPTIONAL: per-agent tokens as "id=token,id2=token2". Usually you don't set these
# by hand — the dashboard's "Add a PC" mints them and the token store persists them.
KENNY_AGENT_TOKENS=

# OPTIONAL: Anthropic API key to enable the server-hosted Claude chat in the dashboard.
ANTHROPIC_API_KEY=

# The server auto-fetches the prebuilt agent binary from GitHub Releases (ADR-0015)
# with no credential at all (ADR-0057), so nothing here is needed for that.
# KENNY_GITHUB_REPO defaults to the canonical nullthrone/kenny; a *private* fork
# cannot be auto-fetched and needs KENNY_AGENT_BINARY placed by hand.
# OPTIONAL: only if you poll a *private* kenny-server package on GHCR (ADR-0040).
KENNY_GITHUB_TOKEN=
KENNY_GITHUB_REPO=nullthrone/kenny

# OPTIONAL (forks): override the container image owner (ghcr.io/$KENNY_OWNER/kenny-server).
KENNY_OWNER=nullthrone

# OPTIONAL (TLS profile): public domain for the bundled Caddy reverse proxy
# (docker compose --profile tls up). Leave empty for local/plain HTTP.
KENNY_DOMAIN=
