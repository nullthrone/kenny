{
  "vectors_version": 1,
  "comment": "Joined decision vectors for the deterministic policy guard. kenny-agent/src/policy.rs and kenny-server/kenny_server/policy.py are hand-written mirrors of each other; this file is the test that fails when they diverge. Each case sets the operator deny rules and the shell policy, calls the guard with one tool call, and asserts the verdict. 'shell': null means no shell policy has ever been applied. See ADR-0019, ADR-0020, ADR-0064.",
  "cases": [
    {
      "name": "builtin_posix_rm_rf_root",
      "shell": {
        "mode": "unrestricted",
        "allow": []
      },
      "operator_deny": [],
      "tool": "shell_exec",
      "args": {
        "command": "rm -rf /"
      },
      "expect": "blocked",
      "why": "built-in catalog rule posix_rm_rf_root"
    },
    {
      "name": "builtin_posix_fork_bomb",
      "shell": {
        "mode": "unrestricted",
        "allow": []
      },
      "operator_deny": [],
      "tool": "shell_exec",
      "args": {
        "command": ":(){ :|: & };:"
      },
      "expect": "blocked",
      "why": "built-in catalog rule posix_fork_bomb"
    },
    {
