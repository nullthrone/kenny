    {
      "name": "allowlist_anchored_rejects_embedded_newline",
      "shell": {
        "mode": "allowlist",
        "allow": [
          {
            "id": "al_uname",
            "applies_to": "posix",
            "pattern": "uname -a",
            "reason": "read kernel version"
