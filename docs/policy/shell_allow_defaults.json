{
  "version": 1,
  "comment": "The shell allow rules a new kenny server starts with, and what Admin -> Shell policy -> Reset to defaults restores (ADR-0064). They take effect only under KENNY_SHELL_POLICY_MODE=allowlist. The set is read-only diagnostics plus one remediation per OS: restarting a named service. Every argument is drawn from an ASCII class without the shell's metacharacters, tokens are separated by a literal space (\\s would also match a newline, which both shells treat as a command separator), and whatever a dedicated tool already covers with its own guard (fs_read, fs_list, winget_*) is left out. Patterns must mean the same in Python re and Rust regex (no lookaround, no backreferences) and must not backtrack exponentially: alternatives at one position start with different characters. docs/fixtures/vectors/shell_allow_defaults.json pins what they admit and what they refuse; both kenny-server and kenny-agent run it.",
  "rules": [
    {
      "id": "al_posix_system_info",
      "applies_to": "posix",
      "pattern": "(uname( -[asnrvmpio]+)*|hostname( -[fsdiIA])?|hostnamectl( status)?|whoami|id( -[unGgr]+)*( [A-Za-z_][A-Za-z0-9_.-]*)?|groups( [A-Za-z_][A-Za-z0-9_.-]*)?|uptime( -[ps]+)?|arch|nproc( --all)?|lsb_release( -[aidrcs]+)*|date( -u)?( -R| -Iseconds| \\+[A-Za-z0-9%:_.-]+)?|timedatectl( status| show| timesync-status)?|lscpu|lsmod|lsusb( -[vt])?|lspci( -[vnkt]+)*|sysctl -a|sysctl( -n)? [a-z0-9_.]+|which( -a)?( [A-Za-z0-9][A-Za-z0-9_.+-]*)+|command -v [A-Za-z0-9][A-Za-z0-9_.+-]*|chronyc (tracking|sources|sourcestats)( -v)?|ntpq -pn?|cat /etc/(os-release|hostname|timezone|machine-id)|cat /proc/(cpuinfo|version|uptime|cmdline))( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Identify the host: kernel, OS release, hostname, time sync, hardware, kernel parameters (read-only; setter forms such as date -s, hostname NAME, sysctl k=v are not matched)."
    },
    {
      "id": "al_posix_resources",
      "applies_to": "posix",
      "pattern": "(free( -[bkmgthwl]+| --si)*|vmstat( -[asw]+)?( [1-9][0-9]? [1-9][0-9]?)?|iostat( -[xzkmhdcN]+)*( [1-9][0-9]? [1-9][0-9]?)?|mpstat( -P ALL)?( [1-9][0-9]? [1-9][0-9]?)?|top -(b -n |bn ?)[1-9]( -c| -o %?[A-Z]+| -w [0-9]{1,3})*|ps( (aux|auxf|auxww|-ef|-eF|-efH|-ely|-eLf|axjf|-[eA]?o [a-z%,:=0-9]+|-p [0-9,]+|-u [A-Za-z_][A-Za-z0-9_.-]*|-C [A-Za-z0-9_.-]+|--sort=[-+]?[a-z%]+|--no-headers))*|sensors|cat /proc/(loadavg|meminfo|pressure/(cpu|memory|io)))( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Load, memory and processes. Interval tools need a bounded count; top only in batch mode; ps without the e/eww forms that print process environments."
    },
    {
      "id": "al_posix_storage",
      "applies_to": "posix",
      "pattern": "(df( -[ahHiklPT]+)*( /[A-Za-z0-9_.@+/-]*)*|lsblk( -[abdfmnpstzJO]+)*|findmnt( -[lnDJ]+)*|du( -[shxc]+| -d [0-9]| --max-depth=[0-9])* /[A-Za-z0-9_.@+/-]*( /[A-Za-z0-9_.@+/-]*)*|swapon (--show|-s)|pvs|vgs|lvs|zpool (status|list)( -[vxP]+)*( [A-Za-z0-9_.-]+)?|zfs list( -[rH]+| -t (all|filesystem|snapshot|volume))*|smartctl (-[HiaAx]+ )+/dev/[A-Za-z0-9/_-]+|smartctl --scan|cat /proc/(mounts|partitions|mdstat|swaps)|cat /etc/fstab)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Disks, filesystems and RAID state (read-only). du needs an explicit absolute path; no wildcards."
    },
    {
      "id": "al_posix_services",
      "applies_to": "posix",
      "pattern": "(systemctl( --no-pager| --plain| --all| -a| -l| --full| --failed| --no-legend| --type=[a-z,]+| -t [a-z,]+| --state=[a-z,-]+| -n [0-9]{1,4}| --lines=[0-9]{1,4}| -o (short|short-iso|short-precise|cat|json|json-pretty|verbose))*( (status|is-active|is-enabled|is-failed|is-system-running|list-units|list-unit-files|list-timers|list-sockets|list-dependencies|list-jobs)(( --no-pager| --plain| --all| -a| -l| --full| --failed| --no-legend| --type=[a-z,]+| -t [a-z,]+| --state=[a-z,-]+| -n [0-9]{1,4}| --lines=[0-9]{1,4}| -o (short|short-iso|short-precise|cat|json|json-pretty|verbose)| [A-Za-z0-9][A-Za-z0-9_.@:-]*))*)?|journalctl( -u [A-Za-z0-9][A-Za-z0-9_.@:-]*| --unit=[A-Za-z0-9][A-Za-z0-9_.@:-]*| -t [A-Za-z0-9_.-]+| -n [0-9]{1,5}| --lines=[0-9]{1,5}| -p [0-7a-z.]+| --priority=[0-7a-z.]+| -b( -?[0-9]{1,3})?| -k| --dmesg| -x| -e| -r| --reverse| --no-pager| --no-hostname| -q| --utc| -a| -o (short|short-iso|short-precise|short-monotonic|json|json-pretty|cat|verbose)| (-S|-U|--since|--until) ([A-Za-z0-9:+-]+|'[ -&(-~]*')| --(since|until)=[A-Za-z0-9:+-]+| --list-boots| --disk-usage| (-g|--grep) ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*'))*|dmesg( -[TxkHtde]+| -l [a-z,]+| --level=[a-z,]+)*)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Service state and logs. systemctl read verbs only (not cat/show, which print unit environments); journalctl without follow, vacuum, rotate or --file; dmesg without clear or console flags."
    },
    {
      "id": "al_posix_service_restart",
      "applies_to": "posix",
      "pattern": "systemctl( --no-block)? (restart|try-restart|reload|reload-or-restart|try-reload-or-restart|reset-failed)( ([A-Za-rt-z0-9]|s([A-Za-xz-z0-9_@:-]|y([A-Za-rt-z0-9_@:-]|s([A-Za-su-z0-9_@:-]|t([A-Za-df-z0-9_@:-]|e([A-Za-ln-z0-9_@:-]|m([A-Za-ce-z0-9_@:-]|d[A-Za-z0-9_@:])))))))[A-Za-z0-9_@:-]*(\\.[0-9][A-Za-z0-9_@:-]*)*(\\.service)?)+",
      "reason": "Restart or reload a service by name - the one remediation in the defaults. Names starting with 'systemd-' and non-.service units (targets, mounts) are not matched: restarting systemd-poweroff.service or poweroff.target would take the host down."
    },
    {
      "id": "al_posix_network",
      "applies_to": "posix",
      "pattern": "(ip( -(4|6|s|d|j|p|br|brief|c=never|color=never))* (a|addr|address|l|link|r|route|n|neigh|neighbor|neighbour|ru|rule|netns|maddr)( (show|list|ls)( [A-Za-z0-9][A-Za-z0-9_.:/@-]*)*)?|ip( -(4|6|s|d|j|p|br|brief|c=never|color=never))* (r|route) get [A-Za-z0-9][A-Za-z0-9.:-]*|ss( -[tulpnaxwemior46H]+)*( state [a-z-]+)?( (sport|dport) = :[0-9]{1,5})?|netstat( -[tulpnrsaeiW]+)*|resolvectl( status| dns| domain| statistics)?|nmcli( -t| -p)*( general( status)?| device( status| show)?| connection( show)?)?|cat /etc/(hosts|resolv\\.conf|nsswitch\\.conf))( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Interfaces, routes, sockets and resolver state (read-only; ip -batch, ss -K and nmcli --show-secrets are not matched)."
    },
    {
      "id": "al_posix_network_probe",
      "applies_to": "posix",
      "pattern": "(ping( -[46n]+)* -c ([1-9]|10)( -W [1-9])? [A-Za-z0-9][A-Za-z0-9.:-]*|traceroute( -[46nI]+)* [A-Za-z0-9][A-Za-z0-9.:-]*|tracepath( -[46n]+)* [A-Za-z0-9][A-Za-z0-9.:-]*|dig( @[A-Za-z0-9][A-Za-z0-9.:-]*| -x [A-Za-z0-9][A-Za-z0-9.:-]*| -t [A-Za-z]{1,10}| [A-Za-z0-9][A-Za-z0-9.-]*| \\+(short|trace|noall|answer|dnssec|tcp|norecurse))+|host( -t [A-Za-z]{1,10})? [A-Za-z0-9][A-Za-z0-9.:-]*( [A-Za-z0-9][A-Za-z0-9.:-]*)?|nslookup( -(type|query)=[A-Za-z]{1,10})? [A-Za-z0-9][A-Za-z0-9.:-]*( [A-Za-z0-9][A-Za-z0-9.:-]*)?|curl -[sSLkv]*I[sSLkv]* https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9_.~/-]*)?)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Reachability and DNS checks. ping needs a count, dig cannot read a batch file, curl only sends HEAD requests (headers, never a body, never file://). Can probe the internal network."
    },
    {
      "id": "al_posix_packages",
      "applies_to": "posix",
      "pattern": "(dpkg (-l( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)*|-s [A-Za-z0-9][A-Za-z0-9_.+:~-]*|-L [A-Za-z0-9][A-Za-z0-9_.+:~-]*|--get-selections)|dpkg-query -W( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)*|apt list( --installed| --upgradable)+|apt-cache (policy|show|depends|rdepends)( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)+|apt-get (-s|--simulate) (upgrade|dist-upgrade)|rpm -q[ailcd]*( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)*( --last)?|rpm -qf /[A-Za-z0-9_.@+/-]*|(dnf|yum)( -q)? (list (installed|updates|upgrades)( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)*|check-update|info( [A-Za-z0-9][A-Za-z0-9_.+:~-]*)+|history( list)?)|snap list|flatpak list|needs-restarting( -r)?|cat /var/run/reboot-required(\\.pkgs)?)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Installed packages and pending updates, including a simulated apt upgrade. Nothing that installs, removes or runs package scripts."
    },
    {
      "id": "al_posix_users",
      "applies_to": "posix",
      "pattern": "(who( -[abHqu]+)?|w( -[hsi]+)?|last( -n [0-9]{1,4}| -[0-9]{1,4}| -[xiFw]+| [A-Za-z_][A-Za-z0-9_.-]*)*|lastlog( -u [A-Za-z_][A-Za-z0-9_.-]*)?|getent (passwd|group)( [A-Za-z_][A-Za-z0-9_.-]*)?|loginctl( list-sessions| list-users| session-status( [0-9]+)?| user-status( [A-Za-z_][A-Za-z0-9_.-]*)?)?|crontab( -u [A-Za-z_][A-Za-z0-9_.-]*)? -l|chage -l [A-Za-z_][A-Za-z0-9_.-]*|faillock( --user [A-Za-z_][A-Za-z0-9_.-]*)?)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Accounts, sessions, logins and crontabs (read-only; getent shadow, crontab -r and faillock --reset are not matched)."
    },
    {
      "id": "al_posix_security_state",
      "applies_to": "posix",
      "pattern": "(sestatus|getenforce|aa-status|apparmor_status|ufw status( verbose| numbered)?|firewall-cmd (--state|--get-active-zones|--list-all-zones|--list-all( --zone=[A-Za-z0-9_-]+)?)|(iptables|ip6tables)( -t (filter|nat|mangle|raw|security))?( -[LnvxS]+| --line-numbers)+|nft list (ruleset|tables))( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Firewall and MAC state (read-only; iptables -F/-Z and nft flush are not matched)."
    },
    {
      "id": "al_posix_containers",
      "applies_to": "posix",
      "pattern": "(docker|podman) (ps( -a| --all| -q| --no-trunc| -s)*|images( -a)?|info|version|stats --no-stream( -a)?|system df( -v)?|compose ls|logs( --tail [0-9]{1,5}| -n [0-9]{1,5}| -t| --timestamps| --since [0-9A-Za-z:.-]+)* [A-Za-z0-9][A-Za-z0-9_.-]*|(top|port) [A-Za-z0-9][A-Za-z0-9_.-]*)( \\| (head -n [0-9]{1,5}|head -[0-9]{1,5}|tail -n [0-9]{1,5}|tail -[0-9]{1,5}|grep( -[ivcwxEFon]+)* ([A-Za-z0-9_.:@/+=,][A-Za-z0-9_.:@/+=,-]*|'[ -&(-~]*')|sort( -[rnhuV]+| -k [0-9,.]+| -t [:,=])*|uniq( -[cdu]+)?|wc( -[lwc]+)?|column -t|cut( -d ?([:,=/.]|' ')| -f ?[0-9,-]+| -c ?[0-9,-]+)+))*",
      "reason": "Container state and recent logs (read-only; no inspect, which prints container environments, and no follow)."
    },
    {
      "id": "al_ps_system_info",
      "applies_to": "powershell",
      "pattern": "(?i)(Get-ComputerInfo|Get-HotFix|Get-CimInstance|Get-WmiObject|Get-TimeZone|Get-Date|Get-Uptime|Get-Culture|Get-Host|Get-ExecutionPolicy|Get-WindowsOptionalFeature|Get-AppxPackage|Get-Package|Get-PnpDevice|Get-Printer|Get-PrintJob|Get-Command|Get-Module)( ([A-Za-z0-9_.,:*\\\\/-]+|'([ -&(-~]|'')*'|@\\{ ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\))( ?; ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))* ?\\}|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))*( \\| ((Format-Table|ft|Format-List|fl|Format-Wide|Select-Object|select|Sort-Object|sort|Measure-Object|measure|Group-Object|group|Out-String|ConvertTo-Json|ConvertTo-Csv|Get-StorageReliabilityCounter)( ([A-Za-z0-9_.,:*\\\\/-]+|'([ -&(-~]|'')*'|@\\{ ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\))( ?; ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))* ?\\}|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))*|(Where-Object|where)( \\{ ?\\$_\\.[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)* -(c|i)?(eq|ne|gt|ge|lt|le|like|notlike|match|notmatch|contains|notcontains|in|notin) ('([ -&(-~]|'')*'|-?[0-9][0-9.]*([kmgt]b)?|\\$(true|false|null)|[A-Za-z_][A-Za-z0-9_.]*)( -(and|or) \\$_\\.[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)* -(c|i)?(eq|ne|gt|ge|lt|le|like|notlike|match|notmatch|contains|notcontains|in|notin) ('([ -&(-~]|'')*'|-?[0-9][0-9.]*([kmgt]b)?|\\$(true|false|null)|[A-Za-z_][A-Za-z0-9_.]*))* ?\\}|( ([A-Za-z0-9_.,:*\\\\/-]+|'([ -&(-~]|'')*'|@\\{ ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\))( ?; ?[A-Za-z]+ ?= ?('([ -&(-~]|'')*'|[0-9]{1,6}(,[0-9]{1,6})*|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))* ?\\}|\\(Get-Date\\)\\.Add(Days|Hours|Minutes)\\(-?[0-9]{1,4}\\)))*)|(Select-String|sls)( -(SimpleMatch|CaseSensitive|NotMatch|AllMatches|Context [0-9]{1,2}))*( -Pattern)? ([A-Za-z0-9_.,:*\\\\/][A-Za-z0-9_.,:*\\\\/-]*|'([ -&(-~]|'')*')( -(SimpleMatch|CaseSensitive|NotMatch|AllMatches|Context [0-9]{1,2}))*))*",
      "reason": "Identify the host: OS, hotfixes, CIM/WMI classes, devices, printers, installed packages (read-only Get- cmdlets; arguments cannot contain variables, subexpressions or script blocks)."
    },
    {
