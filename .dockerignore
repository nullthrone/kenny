# Keep the build context small.
.git
**/target
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/*.sqlite*
**/*.db
.github
docs/*
!docs/policy
kenny-agent
**/.DS_Store

# kenny-web (ADR-0052): source reaches the build context (the Dockerfile's
# Node stage builds it), but never node_modules -- the image installs its own
# inside the build stage -- and never a stray locally-built dist/, which the
# Node stage always regenerates fresh.
kenny-web/node_modules
kenny-server/kenny_server/webui/dist
